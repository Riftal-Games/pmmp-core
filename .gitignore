/.php-cs-fixer.cache

# install-local-protocol.sh
/composer-local-protocol.*

# A global gitignore on this machine matches .claude/, which would
# otherwise silently drop any new file added under it. Anchored so only
# the top-level .claude/ is re-included; a .claude/ in any subdirectory
# stays under the global ignore.
!/.claude/
!/.claude/**

# Last match wins, so anything under .claude/ that must stay untracked
# has to be ignored again after the negations above.
/.claude/settings.local.json
/.claude/**/*.log
/.claude/**/*.txt
/.claude/**/__pycache__/
/.claude/**/Thumbs.db
/.claude/**/Desktop.ini
