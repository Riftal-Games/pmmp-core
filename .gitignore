# install-local-protocol.sh
/composer-local-protocol.*

# The global excludes file ignores the .claude/ directory itself, which
# hides every new file under it. Lifting only the top-level directory
# lets its contents follow this file's rules; the local settings file
# is per-user and stays out.
!/.claude/
/.claude/settings.local.json
